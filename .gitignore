# User-provided game files (never commit - copyrighted).
assets/
res/
roms/
isos/
*.iso
*.xiso
*.xex
*.afs
*.bin
*.awo
*.azt
*.amb
*.amo
*.amg
*.amt
*.rgba

# Save data and save states.
saves/
user_data/

# Build output.
out/
build/
build-*/
release-stage*/
artifacts/
*.exe
*.dll
*.pdb
*.ilk
*.obj
*.tlog

# Tools used by the modding scripts (kept in the repo on purpose).
!tools/xbcompress.exe
!tools/xbdecompress.exe

# Generated code is derived from the copyrighted .xex. Regenerate locally.
generated/*
!generated/README.md

# ReXGlue SDK (third-party, provided separately by rexglue/rexglue-sdk)
rexglue/
/rexglue-sdk/
/rexglue-sdk-*/

# ...except the runtime patches distributed in patches/ (mid-insert virtual AFS).
!patches/
patches/*
!patches/rexglue-sdk/
!patches/rexglue-sdk/**/*.h
!patches/rexglue-sdk/**/*.cpp
!patches/README.md

# Extracted/analysis outputs.
afs_out/
awo_tools/bins_trabajo/

# NumPy data derived from game assets (e.g. awo_tools/psp_ramp.npy = a native
# toon ramp in grey, moveset/gritos_b1.npz = Budokai 1 yells). Never commit.
*.npy
*.npz

# Community modding resources (third-party, large).
modding resources/
modding resources discord/
modding resources update/
modding resources update 2/
modding resources update 3/
mod center/

# User mods (content may carry copyright; keep mods/ for user-built only).
mods/*/us/
mods/*/.disabled

# Python bytecode.
__pycache__/
*.pyc

# User settings / local config.
dbz3_user.toml
*.local.toml
*.local.ini

# Logs, dumps, scratch.
*.log
*.dmp
*.bmp
*.png
*.rgb
*.csv
*.frag
*.bak
*.tmp
crash_*/

# IDE, OS, and language caches.
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Release zips (assets de GitHub, no se versionan)
*.zip

# Archivo local de artefactos de releases antiguas (zips viejos + release-stage
# movidos aqui para despejar la raiz). Se conserva en disco, nunca se versiona.
_archive/

# arte oficial de las historias (no se publica)
mod center hd/campanas/imagenes/

# Documentacion privada (estudios de ports, catalogo de arte de terceros).
docs/07_ports/
docs/13_assets_externos/

# Derivado del codigo generado (lo crea CMake con tools/gen_escenarios_sel.py).
src/escenarios_sel_gen.inc
src/escenarios_sel_gen_eu.inc
