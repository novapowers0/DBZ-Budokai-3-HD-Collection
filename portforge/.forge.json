{
  "defaultVersion": "1.5.5",
  "dependencies": [
    "unzip",
    "7z"
  ],
  "userDataPaths": [
    "install/dbz3_user.toml",
    "install/user_data"
  ],
  "uninstallSteps": [
    {
      "step": "deletePath",
      "path": "install"
    }
  ],
  "builds": [
    {
      "versions": [
        "1.5.5"
      ],
      "targetPlatforms": [
        "Windows"
      ],
      "steps": [
        {
          "step": "createDir",
          "path": ".build"
        },
        {
          "step": "fetch",
          "url": "https://github.com/novapowers0/DBZ-Budokai-3-HD-Collection/releases/download/v1.5.5/DBZ-Budokai-3-HD-Collection-v1.5.5.zip",
          "dest": ".build/port.zip"
        },
        {
          "step": "extract",
          "src": ".build/port.zip",
          "dest": ".build"
        },
        {
          "step": "deletePath",
          "path": ".build/port.zip"
        },
        {
          "step": "copy",
          "from": "rom",
          "dest": ".build/game.iso"
        },
        {
          "step": "move",
          "src": "./.build",
          "dest": "./install"
        },
        {
          "step": "deletePath",
          "path": "./.build"
        },
        {
          "step": "defineExecutable",
          "executable": "install/dbz3.exe",
          "title": "Play"
        }
      ]
    },
