struct Ficha {
  int vida=0, vida_b2=-1, barras=4, casilla=0, desde=0, slot=0, slot_ant=0, anim_b2=0, anim_estado=0;
  bool fuera=true, oculta=false, rival=false;
};
struct Alfombra { int i=-1, dest=0; float t_mueve=0, t_fin=0; bool dende=false; };
struct { std::vector<int> casillas=std::vector<int>(25); } g_d;
std::vector<Ficha> g_f;
Alfombra g_alf;
float g_ahora=2;
bool dbz3_b2_popo_hueco_pal;
constexpr bool dbz3_b2_popo_origen_pal=true;
#define REXCVAR_GET(k) (k)
#define REXLOG_INFO(...) ((void)0)
#define REXLOG_WARN(...) ((void)0)
void SucesosDeCasilla(const Ficha&) {}
