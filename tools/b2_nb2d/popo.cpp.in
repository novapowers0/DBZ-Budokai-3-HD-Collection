@FUNCIONES@

int main() {
  int on, actor, n;
  while (std::cin >> on >> actor >> n) {
    g_f.assign(5, Ficha{});
    if (n < 1 || n > 3 || actor < 1 || actor > 4) return 2;
    dbz3_b2_popo_hueco_pal=on!=0;
    for (int i=0; i<n; ++i) {
      int idx, tile, slot;
      if (!(std::cin >> idx >> tile >> slot) || idx < 1 || idx > 4) return 3;
      Ficha& f=g_f[idx];
      f.fuera=false;
      f.casilla=f.desde=tile;
      f.slot=f.slot_ant=slot;
    }
    g_alf=Alfombra{actor,24,2,3,false};
    ActualizarAlfombra();
    const char* comma="";
    std::cout << '[';
    for (size_t i=1; i<g_f.size(); ++i) {
      const Ficha& f=g_f[i];
      if (f.fuera) continue;
      std::cout << comma << '[' << i << ',' << f.casilla << ',' << f.desde << ',' << f.slot << ',' << f.slot_ant << ']';
      comma=",";
    }
    std::cout << "]\n";
  }
  return std::cin.eof()?0:4;
}
