// dbz3 - Windows VERSIONINFO resource (PE file version).
// Bump VERSION_MAJOR/MINOR/PATCH here when releasing (and mirror in
// make_release.ps1 / RELEASE_README).
// An "EX" repack keeps the PATCH of the release it supersedes and raises BUILD
// by one (v1.2.4-EX -> 1.2.4.1), the same convention as v1.1.4-EX/v1.2.2-EX.
// A normal release raises PATCH and resets BUILD to 0 (v1.2.5 -> 1.2.5.0).
// A follow-up release of the same PATCH (v1.2.8.1, seguimiento del issue #11)
// raises BUILD by one, igual que un repack.
// v1.2.8.2 = rendimiento del escalado de texturas (texturas dinamicas) +
// diagnostico de rendimiento en la propia linea `perf`.
// v1.2.9 = diagnostico pensado para que los reportes se expliquen solos
// (avisos de fps bajo/disco lento instalacion mixta, telemetria vram/lim en
// `perf`, comprobacion de versiones de los ficheros instalados).
// v1.3.0 = release de mejoras del launcher y del runtime: etiquetas de boton
// (Xbox/PlayStation/Switch), boton "Reparar instalacion", fix de la carpeta de
// texturas elegida (issue #13), DRED por defecto (reporte de device lost) +
// gamecontrollerdb.txt enviado junto al exe, pulido visual del launcher y
// optimizacion de E/S (sonda de assets y version cacheadas).
// v1.4.0 = launcher renovado (estilo nuevo, nombre en directo), importador de personajes
// (B1/B2/B3/IW), menu rapido en partida con mando (F1 / Back+Start) y panel de FPS
// (portados de DBZ Burst Limit Recompiled y adaptados), FSR por debajo de la escala
// interna (mas FPS) y ajustes de imagen en vivo; personajes nuevos de B1 (Zarbon, Dodoria).
// v1.4.1 = rendimiento: temporizacion de alta resolucion (30 FPS en equipos potentes con
// Windows 11), pulido del launcher y del kit de mods.
// v1.4.2 = NVIDIA DLSS y AMD FSR 3 (beta), brillo HD regulable, importador de Shin Budokai
// y Super Dragon Ball Heroes, Studio de camaras en el kit de mods.
// v1.4.2.3 = "1.4.2 EX": texturas faciles en PNG, arrastrar mods, aviso de mods rotos,
// Python portatil en el Kit y arreglos de los ports de Shin Budokai.
// v1.4.3 = definitivas para todos los ports (las de Budokai 1 traducidas a B3: Zarbon, Dodoria,
// Androide 19), movesets originales de Infinite World con modo hiper, copias USA/EUR de los
// juegos de origen, launcher y Mod Kit mas faciles (confirmaciones, ES/EN completos).
// v1.4.3.1 = "1.4.3 EX": rendimiento (limitador de FPS sin dormir el hilo de la GPU, vblank
// equiespaciado, ajustes de GPU de Burst Limit), pack de texturas HD para artistas, idiomas.
// v1.4.4 = Tag Team y Online (beta) como mods nativos, Nova's Mods (descargas en el launcher),
// historias propias de Dragon Universe (Freezer) y editor de historias en el Mod Kit.
// v1.4.4.1 = "1.4.4 EX": descargas de Nova's Mods activas, arreglo de relevos seguidos en Tag Team.
// v1.4.4.2 = "1.4.4 EX+": Budokai 2 en el importador (golpes y pelucas), ronda de arreglos de Tag
// Team / Online (beta), Nova's Mods y campanas.
// v1.4.4.5 = "1.4.4 EX MAX Omega": historia de Freezer con dialogos recortados, manejador de errores seguro.
// v1.4.4.4 = "1.4.4 EX MAX". v1.4.4.3 = "1.4.4 EX++": selector de forma inicial LT/RT (beta) con su modelo en la rueda,
// destello en el KO del Tag Team, relevo que espera a la transformacion, imagenes de disco.
// v1.4.4.4 = "1.4.4 EX MAX": menu TAG TEAM en COM VS COM, elegir la ISO desde el aviso, presets
// descritos en el launcher, interruptor del selector de transformacion (beta).
// v1.4.5 = pack de texturas HD sin tirones (carga en segundo plano, precarga aprendida) y en Nova's
// Mods, launcher que coloca y repara los mods solo, buscadores, traducciones IT/DE/FR completas.
// v1.4.5.1 = el pack HD instalado desde el launcher se ve sin reiniciar el juego.
// v1.4.5.2 = Tag Team: ring out con companero vivo = relevo, el que entra carga ki al aterrizar (pose del juego); Online: mods distintos se instalan desde el panel,
// UPnP/STUN; ports oficiales recreables; campanas con textos automaticos (Freezer).
// v1.5.1.1 = minijuegos de IW cotejados con el original (giro, camara, HUD y resultados de IW), heroe con ID propio
// (peinado UT, logo, dos colores), maestros y movesets desbloqueables, Leyenda de Mr. Satan como B1, tablero B2 sin atascos.
// v1.5.1.3 = estudios 1 (tablero B2, nave, Satan, IW, HUD, cierres, issues), IW europea, escenarios sin Office, descarga
// v1.5.1.4 = estudios 2-4 (tablero B2 1:1 en encuadre, Gotenks/Vegito/Shenron, nave, IW europea y NB006, Heroe CaC v2 y movesets, Satan ronda 1, pack HD estable, modo rendimiento)
// con curl y reanudacion.
// v1.5.5 = IW 96/96, nave de Babidi, tablero B2, leyenda de Satán, Modo Héroe beta (sagas 1-3) y Online lockstep beta.
// v1.5.1.2 = escenarios de PS2 (B2/B1/IW) sin Kit ni Python instalado (Python portatil en el zip; ISO elegida con .ruta),
// salir del tablero de B2, heroe: cara propia en la saga, peinado en calvos, scouter, nombres con acentos.
#include <windows.h>

#define VERSION_MAJOR 1
#define VERSION_MINOR 5
#define VERSION_PATCH 5
#define VERSION_BUILD 3
#define DBZ3_VERSION_STR "1.5.5.3"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, VERSION_BUILD
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, VERSION_BUILD
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NovaPowers"
            VALUE "FileDescription", "DBZ Budokai 3 HD Collection - PC recompiled port"
            VALUE "FileVersion", DBZ3_VERSION_STR
            VALUE "InternalName", "dbz3"
            VALUE "LegalCopyright", "(c) 2026 NovaPowers - MIT License"
            VALUE "OriginalFilename", "dbz3.exe"
            VALUE "ProductName", "DBZ Budokai 3 HD Collection"
            VALUE "ProductVersion", DBZ3_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
// Icono del exe en el Explorador: arte propio CC0 (assets_propios/png/app/dbz3.ico, generar.py). En la
// ventana, en marcha, se pone la bola del juego sacada del AFS del jugador (online_panel.cpp, WM_SETICON).
1 ICON "dbz3.ico"
