// dbz3 - Windows VERSIONINFO resource (PE file version).
// Bump VERSION_MAJOR/MINOR/PATCH here when releasing (and mirror in
// make_release.ps1 / RELEASE_README).
#include <windows.h>

#define VERSION_MAJOR 1
#define VERSION_MINOR 1
#define VERSION_PATCH 1

#define DBZ3_VERSION_STR "1.1.1.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NovaPowers"
            VALUE "FileDescription", "DBZ Budokai 3 HD Collection - PC recompiled port"
            VALUE "FileVersion", DBZ3_VERSION_STR
            VALUE "InternalName", "dbz3"
            VALUE "LegalCopyright", "(c) 2026 NovaPowers - MIT License"
            VALUE "OriginalFilename", "dbz3.exe"
            VALUE "ProductName", "DBZ Budokai 3 HD Collection"
            VALUE "ProductVersion", DBZ3_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END